# 统一 LF，避免在 Windows 上 checkout 后 shell 脚本带 CRLF 而无法在 CentOS 执行
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf

*.java  text eol=lf
*.sql   text eol=lf
*.xml   text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.jar   binary