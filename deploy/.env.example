# 复制为 .env 后修改，并执行 chmod 600 .env（该文件已在 .gitignore 中忽略）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-pdm
DB_NAME=pdm
DB_USER=pdm
JWT_SECRET=change-me-64-chars-random-string-for-jwt-signing-key-0123456789
INIT_ADMIN_PASSWORD=Admin@12345
CAPTCHA_ENABLED=true
# Web 端口监听地址：0.0.0.0=局域网可访问（配合防火墙限源）；127.0.0.1=仅虚拟机本机
APP_LISTEN=0.0.0.0
# 宿主机发布端口：容器内固定 8080；宿主机 8080 被别的程序占用时改这里（如 8082）
APP_PORT=8080
# app 容器内存上限（JVM 堆按此值的 70% 计算）；虚拟机内存 >=4G 可改成 2g
APP_MEM_LIMIT=1g
